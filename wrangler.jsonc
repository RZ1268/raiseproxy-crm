{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raiseproxy-crm",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/fusion-api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRM_DB",
        "class_name": "CRMDatabase"
      }
    ]
  },
  "exports": {
    "CRMDatabase": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
